+package expo.modules.plugin
+
+import java.io.File
+import java.util.Properties
+
+object NodeExecutableResolver {
+  /**
+   * Resolves the Node.js binary for Expo/RN Gradle plugins.
+   * Android Studio often starts Gradle without a shell PATH, so bare `node` fails for nvm/Homebrew.
+   *
+   * Order: NODE_BINARY → [androidRoot]/local.properties `node.executable` → common install paths → newest nvm.
+   */
+  fun resolve(androidRoot: File): String {
+    System.getenv("NODE_BINARY")?.trim()?.takeIf { it.isNotEmpty() }?.let { path ->
+      existingFile(expandUser(path))?.let { return it.absolutePath }
+    }
+
+    val lp = File(androidRoot, "local.properties")
+    if (lp.isFile) {
+      runCatching {
+        val props = Properties()
+        lp.inputStream().use { stream -> props.load(stream) }
+        props.getProperty("node.executable")?.trim()?.takeIf { it.isNotEmpty() }?.let { path ->
+          existingFile(expandUser(path))?.let { return it.absolutePath }
+        }
+      }
+    }
+
+    val os = System.getProperty("os.name")?.lowercase().orEmpty()
+    val candidates = mutableListOf<String>()
+    when {
+      os.contains("mac") || os.contains("darwin") -> {
+        candidates.add("/opt/homebrew/bin/node")
+        candidates.add("/usr/local/bin/node")
+      }
+      os.contains("win") -> {
+        System.getenv("ProgramFiles")?.let { candidates.add("$it\\nodejs\\node.exe") }
+      }
+      else -> {
+        candidates.add("/usr/local/bin/node")
+        candidates.add("/usr/bin/node")
+      }
+    }
+    for (p in candidates) {
+      val f = File(p)
+      if (f.isFile) return f.absolutePath
+    }
+
+    val nvmBase = File(System.getProperty("user.home"), ".nvm/versions/node")
+    if (nvmBase.isDirectory) {
+      var best: File? = null
+      var bestMtime = -1L
+      nvmBase.listFiles()?.forEach { verDir ->
+        if (verDir.isDirectory) {
+          val n = File(verDir, "bin/node")
+          if (n.isFile) {
+            val t = n.lastModified()
+            if (t >= bestMtime) {
+              bestMtime = t
+              best = n
+            }
+          }
+        }
+      }
+      best?.let { return it.absolutePath }
+    }
+
+    return "node"
+  }
+
+  private fun expandUser(path: String): String {
+    if (path.startsWith("~")) {
+      return path.replaceFirst("^~".toRegex(), System.getProperty("user.home"))
+    }
+    return path
+  }
+
+  private fun existingFile(path: String): File? {
+    val f = File(path)
+    return if (f.isFile) f else null
+  }
+}
