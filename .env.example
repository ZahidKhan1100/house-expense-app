# Copy to `.env` and restart Metro: `npx expo start -c`
#
# API base URL is set only in `src/config/api.ts` (edit `RAW` there for local vs production).
#
# Native Android: `app.json` references `./google-services.json`. Download it from Firebase
# Console (Project settings → your Android app) and save it at the project root before
# `npx expo prebuild --platform android` (the file is gitignored — keep a local copy).

# Google Sign-In: prefer `app.json` → `expo.extra.googleAuth` (same as sdk-55 / backend).
# Optional overrides (if set, they win over app.json):
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
