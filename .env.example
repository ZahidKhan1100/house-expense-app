# Copy to `.env` and adjust. Restart Metro after changes (`npx expo start -c`).

EXPO_PUBLIC_API_BASE_URL=https://habimate.com/api/v1

# Google Sign-In: prefer `app.json` → `expo.extra.googleAuth` (same as sdk-55 / backend).
# Optional overrides (if set, they win over app.json):
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
